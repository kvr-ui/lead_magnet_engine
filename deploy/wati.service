[Unit]
Description=Bigin -> WATI CSV cleaner (Python backend)
After=network.target

[Service]
Type=simple
# Change User/Group and paths to match your server.
User=www-data
Group=www-data
WorkingDirectory=/opt/wati_cleanup/backend/python
Environment=HOST=127.0.0.1
Environment=PORT=8000
ExecStart=/usr/bin/python3 /opt/wati_cleanup/backend/python/app.py
Restart=always
RestartSec=2

# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
