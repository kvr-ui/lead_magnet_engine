# Copy to .env and fill in per-deployment. This file is loaded once at
# process startup (see index.js) — no code changes needed to reconfigure.

HOST=0.0.0.0
PORT=3000
PY_TARGET=http://127.0.0.1:8000
MONGODB_URI=mongodb://127.0.0.1:27017/wati_cleanup

# Where the lead magnet field definitions live. Add a new lead magnet by
# editing this file (or wherever this points) — no code change, no restart
# of the Python backend, just restart this Node process.
LEAD_MAGNETS_CONFIG=./config/leadMagnets.json

# Shared secret for the Zoho Bigin contact webhook (POST /api/contacts/webhook).
# Set this, then have Zoho Flow send it as the "x-webhook-secret" header or a
# ?secret=... query param. Leave blank to accept unauthenticated webhooks.
CONTACTS_WEBHOOK_SECRET=

# Connection string for the external ad/lead-magnet database. Kept as its own
# connection (mongoose.createConnection), separate from MONGODB_URI above —
# read-only, viewed at /admin/ad-magnet. Leave blank to disable that page.
AD_MAGNET_MONGODB_URI=

# HTTP Basic Auth for admin surfaces: the leads dashboard (/admin/leads), the
# lead-magnets admin UI (/admin/lead-magnets), GET /api/contacts, GET/POST
# /api/contacts/import, GET /api/leads/:magnetKey, /api/ad-magnet/*, and all
# /api/campaigns* routes. Public endpoints (webhook, lead-magnet submission
# form, lead-magnet config) are unaffected. Leave both blank to disable auth
# (fine for local dev; a startup warning is logged) — set both before any
# real deployment, since campaigns can now send real WhatsApp messages.
ADMIN_USER=
ADMIN_PASSWORD=

# --- Drip campaigns (lib/campaignEngine.js, routes/campaigns.js) -----------
# The WhatsApp provider connection is managed from the Integrations tab in
# the admin UI (stored in MongoDB, token encrypted — see
# lib/whatsappProvider.js, models/WhatsAppIntegration.js), not from env vars.
#
# WATI_API_ENDPOINT / WATI_API_TOKEN / CHANNEL_NUMBER* below are ONE-TIME
# BOOTSTRAP ONLY: if set and no WhatsAppIntegration doc exists yet, they're
# migrated into MongoDB automatically on first startup, then never read
# again — manage the connection from the Integrations tab from then on.
WATI_API_ENDPOINT=
WATI_API_TOKEN=
CHANNEL_NUMBER=
CHANNEL_NUMBER_2=

# 32-byte base64 key used to encrypt the WhatsApp provider token at rest in
# MongoDB (generate with `openssl rand -base64 32`). This is an application
# secret, not a provider credential — required before any provider can be
# connected via the Integrations tab.
INTEGRATION_ENCRYPTION_KEY=

# How often (ms) the poller checks for due drip messages to send.
CAMPAIGN_POLL_INTERVAL_MS=300000
# Max due messages sent per poll tick, and the gap (ms) between each send —
# keeps sending well under the connected provider's rate limits instead of
# a burst.
CAMPAIGN_BATCH_SIZE=20
CAMPAIGN_SEND_GAP_MS=1000
